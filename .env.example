# Copy this file to .env. Do not commit .env.

# Gemini API key from Google AI Studio (free tier). Create it in the project below.
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# The GCP project from scripts/setup-gcp.sh. BigQuery runs query jobs here.
GOOGLE_CLOUD_PROJECT=

# Model IDs (P17).
DCA_MODEL=gemini-3.8-flash
DCA_FALLBACK_MODEL=gemini-3.5-flash-lite

# Optional. Chaos mode injects failures into the LLM and BigQuery adapters (HLD 15.6).
# CHAOS=llm_429:0.3,bq_timeout:0.1
# CHAOS_SEED=7

# Optional. Override any value of config/defaults.toml: DCA_<SECTION>__<KEY>.
# DCA_BUDGET__LLM_CALLS=8
